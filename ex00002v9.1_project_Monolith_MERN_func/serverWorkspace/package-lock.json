{
  "name": "serverworkspace",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "serverworkspace",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@server/lib-common": {
      "resolved": "packages/lib-common",
      "link": true
    },
    "packages/lib-common": {
      "name": "@server/lib-common",
      "version": "1.0.0",
      "devDependencies": {
        "typescript": "^5.9.3"
      }
    },
    "packages/lib-common/node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    }
  }
}
